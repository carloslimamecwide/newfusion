# Variáveis de ambiente necessárias
# Copiar este ficheiro para .env e preencher os valores
# Ou adicionar como GitHub Actions Secrets em Settings → Secrets → Actions

# Resend API (envio de emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email do formulário de contacto
CONTACT_FROM=contato@webfusionlab.pt
CONTACT_TO=carlos@webfusionlab.pt

# Site URL
NEXT_PUBLIC_SITE_URL=https://webfusionlab.pt

# WhatsApp (número internacional sem +)
NEXT_PUBLIC_WHATSAPP_NUMBER=351912345678

# Calendly (deixar vazio se não usar)
NEXT_PUBLIC_CALENDLY_URL=
